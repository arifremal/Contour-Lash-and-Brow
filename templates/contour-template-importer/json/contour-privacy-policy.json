        {
          "id": "ecc89a71",
          "elType": "widget",
          "widgetType": "text-editor",
          "isInner": false,
          "settings": {
            "editor": "We may collect your name, phone number, email address, appointment details, patch-test records, and any notes you share about sensitivities, eye health, or preferred lash styles. If you book online through Acuity Scheduling, that platform also collects the details needed to create your booking.",
            "align": "left",
            "text_color": "#5E5E5E",
