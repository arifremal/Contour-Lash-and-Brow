                    "html": "<form action=\"mailto:Contourlashbrowperth@gmail.com\" method=\"post\" enctype=\"text/plain\" style=\"display:flex;flex-direction:column;gap:14px;\">\n<label style=\"font-family:Cinzel,serif;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#3E2D25;\">Name\n<input required name=\"name\" style=\"width:100%;border:1px solid #DBBCB0;padding:12px 14px;font-size:16px;box-sizing:border-box;\"></label>\n<label style=\"font-family:Cinzel,serif;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#3E2D25;\">Email\n<input required type=\"email\" name=\"email\" style=\"width:100%;border:1px solid #DBBCB0;padding:12px 14px;font-size:16px;box-sizing:border-box;\"></label>\n<label style=\"font-family:Cinzel,serif;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#3E2D25;\">Phone\n<input name=\"phone\" style=\"width:100%;border:1px solid #DBBCB0;padding:12px 14px;font-size:16px;box-sizing:border-box;\"></label>\n<label style=\"font-family:Cinzel,serif;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#3E2D25;\">Message\n<textarea required name=\"message\" rows=\"5\" style=\"width:100%;border:1px solid #DBBCB0;padding:12px 14px;font-size:16px;box-sizing:border-box;\"></textarea></label>\n<button type=\"submit\" style=\"min-width:150px;padding:12px 28px;border:1px solid #8F6F63;background:#DBBCB0;color:#362720;font-family:Cinzel,serif;letter-spacing:.12em;text-transform:uppercase;cursor:pointer;\">Send message</button>\n</form>"
